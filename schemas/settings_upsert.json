{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "appointments.settings.upsert",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "default_duration": {
      "type": "integer",
      "title": "Default duration (minutes)",
      "minimum": 1,
      "default": 60
    },
    "min_booking_notice": {
      "type": "integer",
      "title": "Minimum booking notice (minutes)",
      "minimum": 0,
      "default": 60
    },
    "max_advance_booking": {
      "type": "integer",
      "title": "Book at most this far ahead (days)",
      "minimum": 0,
      "default": 90
    },
    "allow_overlapping": {
      "type": "boolean",
      "title": "Allow overlapping appointments",
      "default": false
    },
    "send_reminders": {
      "type": "boolean",
      "title": "Send reminders",
      "default": true
    },
    "reminder_hours_before": {
      "type": "integer",
      "title": "Send the reminder this many hours before",
      "minimum": 0,
      "default": 24
    },
    "allow_customer_cancellation": {
      "type": "boolean",
      "title": "Let customers cancel their appointment",
      "default": true
    },
    "cancellation_notice_hours": {
      "type": "integer",
      "title": "Minimum cancellation notice (hours)",
      "minimum": 0,
      "default": 24
    },
    "calendar_start_hour": {
      "type": "integer",
      "title": "Calendar starts at (hour)",
      "minimum": 0,
      "maximum": 23,
      "default": 8
    },
    "calendar_end_hour": {
      "type": "integer",
      "title": "Calendar ends at (hour)",
      "minimum": 1,
      "maximum": 24,
      "default": 20
    },
    "slot_interval": {
      "type": "integer",
      "title": "Slot interval (minutes)",
      "minimum": 1,
      "default": 15
    },
    "hold_minutes": {
      "type": "integer",
      "title": "Hold a slot for (minutes)",
      "minimum": 0,
      "maximum": 120,
      "default": 15,
      "description": "Minutes a slot stays set aside while somebody decides on a pending booking request. 0 switches holds off."
    }
  }
}
