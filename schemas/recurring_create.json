{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "appointments.recurring.create",
  "type": "object",
  "additionalProperties": false,
  "required": ["customer_name", "service_name", "frequency", "time", "duration_minutes", "start_date"],
  "properties": {
    "customer_id": { "type": ["string", "null"], "default": null },
    "customer_name": { "type": "string", "minLength": 1, "maxLength": 200 },
    "service_id": { "type": ["string", "null"], "default": null },
    "service_name": { "type": "string", "minLength": 1, "maxLength": 200 },
    "staff_id": { "type": ["string", "null"], "default": null },
    "staff_name": { "type": "string", "default": "", "maxLength": 200 },
    "frequency": { "type": "string", "enum": ["daily", "weekly", "biweekly", "monthly"] },
    "day_of_week": { "type": ["integer", "null"], "minimum": 0, "maximum": 6, "default": null },
    "time": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
    "duration_minutes": { "type": "integer", "minimum": 1 },
    "start_date": { "type": "string", "format": "date" },
    "end_date": { "type": ["string", "null"], "format": "date", "default": null },
    "max_occurrences": { "type": ["integer", "null"], "minimum": 1, "default": null }
  }
}
