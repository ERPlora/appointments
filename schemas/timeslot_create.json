{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "appointments.timeslots.create",
  "type": "object",
  "additionalProperties": false,
  "required": ["schedule_id", "day_of_week", "start_time", "end_time"],
  "properties": {
    "schedule_id": { "type": "string", "minLength": 1 },
    "day_of_week": { "type": "integer", "minimum": 0, "maximum": 6 },
    "start_time": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
    "end_time": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" }
  }
}
