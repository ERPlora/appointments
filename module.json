{
  "id": "appointments",
  "name": "Appointments",
  "version": "1.1.32",
  "description": "Book client appointments against services and staff, and track them from booked to completed.",
  "agent": {
    "description": "Schedules and manages client appointments: books slots against services and staff, tracks status lifecycle (pending → confirmed → in_progress → completed / cancelled / no_show), manages staff availability and blocked time, and handles recurring appointment templates.",
    "keywords": [
      "appointment",
      "booking",
      "schedule",
      "availability",
      "calendar",
      "timeslot",
      "recurring"
    ]
  },
  "depends_on": [
    "customers",
    "services",
    "staff"
  ],
  "permissions": [
    "appointments.view_appointment",
    "appointments.add_appointment",
    "appointments.change_appointment",
    "appointments.delete_appointment",
    "appointments.view_schedule",
    "appointments.manage_schedule",
    "appointments.manage_settings"
  ],
  "role_permissions": {
    "admin": [
      "*"
    ],
    "manager": [
      "appointments.view_appointment",
      "appointments.add_appointment",
      "appointments.change_appointment",
      "appointments.view_schedule",
      "appointments.manage_schedule"
    ],
    "employee": [
      "appointments.view_appointment",
      "appointments.add_appointment",
      "appointments.view_schedule"
    ]
  },
  "navigation": [
    {
      "id": "appointments",
      "label": "Appointments",
      "icon": "calendar-outline",
      "component": "erp-appointments-list"
    }
  ],
  "settings": {
    "title": "Appointments",
    "icon": "calendar-outline",
    "schema": "schemas/settings_upsert.json",
    "get": "appointments.settings.get",
    "set": "appointments.settings.upsert"
  },
  "ai_context": {
    "summary": "Schedule and manage client appointments and availability. Books appointments against services and customers, tracks status (pending → confirmed → in_progress → completed / cancelled / no_show), manages staff schedules with weekly time slots, blocked time (holidays/vacations) and recurring appointment templates.",
    "depends_on": [
      "customers",
      "services",
      "staff"
    ]
  },
  "migrations": {
    "postgres": [
      "migrations/postgres/001_init.sql",
      "migrations/postgres/002_counter.sql",
      "migrations/postgres/003_gate.sql",
      "migrations/postgres/004_converted_sale.sql"
    ]
  },
  "queries": {
    "appointments.appointments.list": {
      "permission": "appointments.view_appointment",
      "sql": "queries/appointments_list.sql",
      "ai": {
        "description": "Lists scheduled appointments with their status and associated customer and service data."
      }
    },
    "appointments.appointments.get": {
      "permission": "appointments.view_appointment",
      "sql": "queries/appointment_get.sql",
      "ai": {
        "description": "Retrieves the full detail of an appointment by its identifier."
      }
    },
    "appointments.appointments.history": {
      "permission": "appointments.view_appointment",
      "sql": "queries/appointment_history.sql",
      "ai": {
        "description": "Retrieves the status-change history of a specific appointment."
      }
    },
    "appointments.schedules.list": {
      "permission": "appointments.view_schedule",
      "sql": "queries/schedules_list.sql",
      "list": {
        "search": [
          "name",
          "description"
        ],
        "sort": [
          "id",
          "name",
          "description",
          "is_default",
          "is_active"
        ],
        "default_sort": "name",
        "default_dir": "asc",
        "filters": {
          "name": {
            "op": "like"
          },
          "description": {
            "op": "like"
          },
          "is_default": {
            "op": "eq"
          },
          "is_active": {
            "op": "eq"
          }
        },
        "page_size": 50
      },
      "ai": {
        "description": "Lists the availability schedules configured for staff members."
      }
    },
    "appointments.schedules.timeslots": {
      "permission": "appointments.view_schedule",
      "sql": "queries/schedule_timeslots.sql",
      "ai": {
        "description": "Retrieves the available time slots for a given staff schedule."
      }
    },
    "appointments.availability.slots": {
      "permission": "appointments.view_schedule",
      "sql": "queries/availability_slots.sql",
      "ai": {
        "description": "Returns the free booking slots for a given date (optionally for a specific staff member and duration), crossing schedules, blocked time and existing appointments with the booking-notice settings."
      }
    },
    "appointments.availability.check": {
      "permission": "appointments.view_schedule",
      "sql": "queries/availability_check.sql",
      "ai": {
        "description": "Checks whether a specific date/time slot is available for booking and returns the reason when it is not (too_soon, too_far, outside_schedule, blocked or overlap)."
      }
    },
    "appointments.blocked_times.list": {
      "permission": "appointments.view_schedule",
      "sql": "queries/blocked_times_list.sql",
      "list": {
        "search": [
          "title"
        ],
        "sort": [
          "id",
          "title",
          "block_type",
          "start_datetime",
          "end_datetime",
          "all_day",
          "staff_id",
          "reason"
        ],
        "default_sort": "id",
        "default_dir": "asc",
        "filters": {
          "title": {
            "op": "like"
          },
          "block_type": {
            "op": "eq"
          },
          "start_datetime": {
            "op": "eq"
          },
          "end_datetime": {
            "op": "eq"
          },
          "all_day": {
            "op": "eq"
          },
          "staff_id": {
            "op": "eq"
          },
          "reason": {
            "op": "like"
          }
        },
        "page_size": 50
      },
      "ai": {
        "description": "Lists blocked time periods (holidays, vacations) for staff members."
      }
    },
    "appointments.recurring.list": {
      "permission": "appointments.view_appointment",
      "sql": "queries/recurring_list.sql",
      "list": {
        "search": [
          "customer_name",
          "service_name",
          "staff_name"
        ],
        "sort": [
          "id",
          "customer_name",
          "service_name",
          "staff_name",
          "frequency",
          "day_of_week",
          "time",
          "duration_minutes",
          "start_date",
          "end_date",
          "max_occurrences",
          "is_active"
        ],
        "default_sort": "id",
        "default_dir": "asc",
        "filters": {
          "customer_name": {
            "op": "like"
          },
          "service_name": {
            "op": "like"
          },
          "staff_name": {
            "op": "like"
          },
          "frequency": {
            "op": "eq"
          },
          "day_of_week": {
            "op": "eq"
          },
          "time": {
            "op": "eq"
          },
          "duration_minutes": {
            "op": "eq"
          },
          "start_date": {
            "op": "range"
          },
          "end_date": {
            "op": "range"
          },
          "max_occurrences": {
            "op": "range"
          },
          "is_active": {
            "op": "eq"
          }
        },
        "page_size": 50
      },
      "ai": {
        "description": "Lists configured recurring appointment templates."
      }
    },
    "appointments.agenda.status": {
      "permission": "appointments.view_schedule",
      "sql": "queries/agenda_status.sql",
      "ai": {
        "description": "Reports whether the agenda is set up: how many active schedules and bookable weekly time slots the business has declared."
      }
    },
    "appointments.settings.get": {
      "permission": "appointments.view_appointment",
      "sql": "queries/settings_get.sql",
      "ai": {
        "description": "Retrieves the general settings of the appointments module."
      }
    },
    "appointments.appointments.conflicting": {
      "permission": "appointments.view_appointment",
      "sql": "queries/appointments_conflicting.sql",
      "ai": {
        "description": "Loads live appointments for the same day as the requested start, used by the create handler to detect overlapping bookings authoritatively (runtime reads)."
      }
    }
  },
  "commands": {
    "appointments.appointments.create": {
      "permission": "appointments.add_appointment",
      "schema": "schemas/appointment_create.json",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "create_appointment"
      },
      "emit": [
        "appointments.appointment.created"
      ],
      "ai": {
        "description": "Creates a new appointment for a customer with a specified service and date/time."
      },
      "reads": [
        {
          "query": "appointments.appointments.conflicting",
          "params": {
            "staff_id": "payload.staff_id",
            "start_datetime": "payload.start_datetime"
          }
        },
        {
          "query": "appointments.settings.get",
          "required": true
        }
      ]
    },
    "appointments.appointments.update": {
      "permission": "appointments.change_appointment",
      "transaction": true,
      "sql": [
        "commands/appointment_update.sql",
        "commands/_appointment_overlap_assert.sql"
      ],
      "schema": "schemas/appointment_update.json",
      "emit": [
        "appointments.appointment.updated"
      ],
      "ai": {
        "description": "Updates an existing appointment's details such as notes, duration, or assigned employee."
      }
    },
    "appointments.appointments.confirm": {
      "permission": "appointments.change_appointment",
      "transaction": true,
      "sql": [
        "commands/appointment_confirm.sql",
        "commands/_history_confirm.sql"
      ],
      "expect_rows": {
        "op": "min",
        "n": 1,
        "error": "appointments.cannot_confirm",
        "message": "This appointment can no longer be confirmed: it is not pending any more."
      },
      "schema": "schemas/appointment_id.json",
      "emit": [
        "appointments.appointment.confirmed"
      ],
      "ai": {
        "description": "Confirms a pending appointment, changing its status to confirmed."
      }
    },
    "appointments.appointments.start": {
      "permission": "appointments.change_appointment",
      "transaction": true,
      "sql": [
        "commands/appointment_start.sql",
        "commands/_history_start.sql"
      ],
      "expect_rows": {
        "op": "min",
        "n": 1,
        "error": "appointments.cannot_start",
        "message": "This appointment cannot be started: it is not confirmed."
      },
      "schema": "schemas/appointment_id.json",
      "emit": [
        "appointments.appointment.started"
      ],
      "ai": {
        "description": "Marks a confirmed appointment as in progress (service started)."
      }
    },
    "appointments.appointments.complete": {
      "permission": "appointments.change_appointment",
      "transaction": true,
      "sql": [
        "commands/appointment_complete.sql",
        "commands/_history_complete.sql"
      ],
      "expect_rows": {
        "op": "min",
        "n": 1,
        "error": "appointments.cannot_complete",
        "message": "This appointment cannot be completed: it has not been started."
      },
      "schema": "schemas/appointment_id.json",
      "emit": [
        "appointments.appointment.completed"
      ],
      "ai": {
        "description": "Marks an in-progress appointment as completed."
      }
    },
    "appointments.appointments.cancel": {
      "permission": "appointments.change_appointment",
      "schema": "schemas/appointment_cancel.json",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "cancel_appointment"
      },
      "reads": [
        {
          "query": "appointments.appointments.get",
          "params": {
            "appointment_id": "payload.appointment_id"
          },
          "required": true
        },
        {
          "query": "appointments.settings.get",
          "required": true
        }
      ],
      "emit": [
        "appointments.appointment.cancelled"
      ],
      "ai": {
        "description": "Cancels an appointment with a specified cancellation reason. Staff can always cancel; a cancellation on behalf of the customer (channel=customer) is subject to the cancellation policy (allow_customer_cancellation, cancellation_notice_hours)."
      }
    },
    "appointments._cancel_row": {
      "permission": "appointments.change_appointment",
      "sql": [
        "commands/appointment_cancel.sql"
      ]
    },
    "appointments._history_cancel": {
      "permission": "appointments.change_appointment",
      "sql": [
        "commands/_history_cancel.sql"
      ]
    },
    "appointments.appointments.no_show": {
      "permission": "appointments.change_appointment",
      "transaction": true,
      "sql": [
        "commands/appointment_no_show.sql",
        "commands/_history_no_show.sql"
      ],
      "expect_rows": {
        "op": "min",
        "n": 1,
        "error": "appointments.cannot_mark_no_show",
        "message": "This appointment cannot be marked as a no-show in its current state."
      },
      "schema": "schemas/appointment_id.json",
      "emit": [
        "appointments.appointment.no_show"
      ],
      "ai": {
        "description": "Records that the customer did not show up for their scheduled appointment."
      }
    },
    "appointments.appointments.reschedule": {
      "permission": "appointments.change_appointment",
      "transaction": true,
      "sql": [
        "commands/_reschedule_state_assert.sql",
        "commands/appointment_reschedule.sql",
        "commands/_appointment_overlap_assert.sql",
        "commands/_history_reschedule.sql"
      ],
      "schema": "schemas/appointment_reschedule.json",
      "emit": [
        "appointments.appointment.rescheduled"
      ],
      "ai": {
        "description": "Reschedules an appointment to a new date and time."
      }
    },
    "appointments.appointments.delete": {
      "permission": "appointments.delete_appointment",
      "transaction": true,
      "sql": [
        "commands/appointment_delete.sql"
      ],
      "schema": "schemas/appointment_id.json",
      "emit": [
        "appointments.appointment.deleted"
      ],
      "ai": {
        "description": "Permanently deletes an appointment from the system (destructive)."
      }
    },
    "appointments.appointments.bulk_create": {
      "permission": "appointments.add_appointment",
      "schema": "schemas/appointment_bulk_create.json",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "bulk_create"
      },
      "ai": {
        "description": "Creates multiple appointments in bulk from a list of appointment data."
      }
    },
    "appointments.appointments.bulk_delete": {
      "permission": "appointments.delete_appointment",
      "schema": "schemas/appointment_bulk_delete.json",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "bulk_delete"
      },
      "ai": {
        "description": "Permanently deletes multiple appointments in bulk (destructive)."
      }
    },
    "appointments.recurring.materialize": {
      "permission": "appointments.add_appointment",
      "schema": "schemas/recurring_materialize.json",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "materialize_recurring"
      },
      "ai": {
        "description": "Generates concrete appointment instances from a recurring appointment template."
      }
    },
    "appointments._bump_counter": {
      "permission": "appointments.add_appointment",
      "sql": [
        "commands/_bump_counter.sql"
      ]
    },
    "appointments._insert_appointment": {
      "permission": "appointments.add_appointment",
      "sql": [
        "commands/_insert_appointment.sql"
      ]
    },
    "appointments._insert_history": {
      "permission": "appointments.change_appointment",
      "sql": [
        "commands/_insert_history.sql"
      ]
    },
    "appointments.schedules.create": {
      "permission": "appointments.manage_schedule",
      "transaction": true,
      "sql": [
        "commands/schedule_create.sql"
      ],
      "schema": "schemas/schedule_create.json",
      "emit": [
        "appointments.schedule.created"
      ],
      "ai": {
        "description": "Creates a new availability schedule for an employee or resource."
      }
    },
    "appointments.schedules.delete": {
      "permission": "appointments.manage_schedule",
      "transaction": true,
      "sql": [
        "commands/schedule_delete.sql"
      ],
      "schema": "schemas/schedule_id.json",
      "emit": [
        "appointments.schedule.deleted"
      ],
      "ai": {
        "description": "Deletes an existing staff availability schedule (destructive)."
      }
    },
    "appointments.timeslots.create": {
      "permission": "appointments.manage_schedule",
      "transaction": true,
      "sql": [
        "commands/timeslot_create.sql"
      ],
      "schema": "schemas/timeslot_create.json",
      "ai": {
        "description": "Adds a time slot block to a staff availability schedule."
      },
      "expect_rows": {
        "op": "min",
        "n": 1,
        "error": "appointments.schedule_unavailable",
        "message": "That schedule is not available: it does not exist in this business or it has been deleted."
      }
    },
    "appointments.timeslots.delete": {
      "permission": "appointments.manage_schedule",
      "transaction": true,
      "sql": [
        "commands/timeslot_delete.sql"
      ],
      "schema": "schemas/timeslot_id.json",
      "ai": {
        "description": "Removes a time slot block from a staff availability schedule (destructive)."
      }
    },
    "appointments.blocked_times.create": {
      "permission": "appointments.manage_schedule",
      "transaction": true,
      "sql": [
        "commands/blocked_time_create.sql"
      ],
      "schema": "schemas/blocked_time_create.json",
      "emit": [
        "appointments.blocked_time.created"
      ],
      "ai": {
        "description": "Registers a blocked time period for an employee (holiday, vacation, etc.)."
      }
    },
    "appointments.blocked_times.delete": {
      "permission": "appointments.manage_schedule",
      "transaction": true,
      "sql": [
        "commands/blocked_time_delete.sql"
      ],
      "schema": "schemas/blocked_time_id.json",
      "ai": {
        "description": "Removes a blocked time period from an employee's schedule (destructive)."
      }
    },
    "appointments.recurring.create": {
      "permission": "appointments.add_appointment",
      "transaction": true,
      "sql": [
        "commands/recurring_create.sql"
      ],
      "schema": "schemas/recurring_create.json",
      "emit": [
        "appointments.recurring.created"
      ],
      "ai": {
        "description": "Creates a recurring appointment template with its repetition pattern."
      }
    },
    "appointments.recurring.delete": {
      "permission": "appointments.change_appointment",
      "transaction": true,
      "sql": [
        "commands/recurring_delete.sql"
      ],
      "schema": "schemas/recurring_id.json",
      "ai": {
        "description": "Deletes a recurring appointment template (destructive)."
      }
    },
    "appointments.settings.upsert": {
      "permission": "appointments.manage_settings",
      "transaction": true,
      "sql": [
        "commands/settings_upsert.sql"
      ],
      "schema": "schemas/settings_upsert.json",
      "emit": [
        "appointments.settings.updated"
      ],
      "ai": {
        "description": "Creates or updates the general settings for the appointments module."
      }
    },
    "appointments._mark_converted": {
      "permission": "appointments.change_appointment",
      "transaction": true,
      "sql": [
        "commands/_mark_converted.sql"
      ]
    }
  },
  "events": {
    "listen": {
      "sales.sale.created_from_appointment": {
        "command": "appointments._mark_converted"
      }
    },
    "emits": [
      "appointments.appointment.cancelled",
      "appointments.appointment.completed",
      "appointments.appointment.confirmed",
      "appointments.appointment.created",
      "appointments.appointment.deleted",
      "appointments.appointment.no_show",
      "appointments.appointment.rescheduled",
      "appointments.appointment.started",
      "appointments.appointment.updated",
      "appointments.blocked_time.created",
      "appointments.recurring.created",
      "appointments.schedule.created",
      "appointments.schedule.deleted",
      "appointments.settings.updated"
    ]
  },
  "ui": {
    "entry": "dist/appointments.esm.js"
  },
  "setup": {
    "query": "appointments.agenda.status",
    "configured_when": [
      {
        "field": "weekly_time_slots",
        "truthy": true
      }
    ],
    "title": "Your working hours",
    "description": "Tell the hub the days and times you work, so the agenda only offers slots while you are open.",
    "icon": "time-outline",
    "route": "/m/appointments/appointments",
    "permission": "appointments.manage_schedule",
    "countries": [],
    "order": 101,
    "required": false
  }
}
