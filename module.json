{
  "id": "appointments",
  "name": "Appointments",
  "version": "1.1.45",
  "description": "Book client appointments against services and staff, and track them from booked to completed.",
  "agent": {
    "description": "Schedules and manages client appointments: books slots against services and staff, tracks status lifecycle (pending → confirmed → in_progress → completed / cancelled / no_show), manages staff availability and blocked time, and handles recurring appointment templates.",
    "keywords": [
      "appointment",
      "booking",
      "schedule",
      "availability",
      "calendar",
      "timeslot",
      "recurring"
    ]
  },
  "depends_on": [
    "customers",
    "services",
    "staff"
  ],
  "permissions": [
    "appointments.view_appointment",
    "appointments.add_appointment",
    "appointments.change_appointment",
    "appointments.delete_appointment",
    "appointments.view_schedule",
    "appointments.manage_schedule",
    "appointments.manage_settings"
  ],
  "role_permissions": {
    "admin": [
      "*"
    ],
    "manager": [
      "appointments.view_appointment",
      "appointments.add_appointment",
      "appointments.change_appointment",
      "appointments.view_schedule",
      "appointments.manage_schedule"
    ],
    "employee": [
      "appointments.view_appointment",
      "appointments.add_appointment",
      "appointments.view_schedule"
    ]
  },
  "navigation": [
    {
      "id": "appointments",
      "label": "Appointments",
      "icon": "calendar-outline",
      "component": "erp-appointments-list"
    }
  ],
  "provides_slots": [
    {
      "slot": "customers.detail",
      "component": "erp-appointments-customer-history",
      "permission": "appointments.view_appointment",
      "priority": 100
    },
    {
      "slot": "whatsapp_inbox.request.booking",
      "component": "erp-appointments-request-booking",
      "permission": "appointments.add_appointment",
      "priority": 100
    }
  ],
  "settings": {
    "title": "Appointments",
    "icon": "calendar-outline",
    "schema": "schemas/settings_upsert.json",
    "get": "appointments.settings.get",
    "set": "appointments.settings.upsert"
  },
  "ai_context": {
    "summary": "Schedule and manage client appointments and availability. Books appointments against services and customers, tracks status (pending → confirmed → in_progress → completed / cancelled / no_show), manages staff schedules with weekly time slots, blocked time (holidays/vacations) and recurring appointment templates.",
    "depends_on": [
      "customers",
      "services",
      "staff"
    ]
  },
  "migrations": {
    "postgres": [
      "migrations/postgres/001_init.sql",
      "migrations/postgres/002_counter.sql",
      "migrations/postgres/003_gate.sql",
      "migrations/postgres/004_converted_sale.sql",
      "migrations/postgres/005_recurring_occurrence.sql",
      "migrations/postgres/006_slot_hold.sql"
    ]
  },
  "queries": {
    "appointments.appointments.list": {
      "permission": "appointments.view_appointment",
      "sql": "queries/appointments_list.sql",
      "ai": {
        "description": "Lists scheduled appointments with their status and associated customer and service data."
      }
    },
    "appointments.appointments.get": {
      "permission": "appointments.view_appointment",
      "sql": "queries/appointment_get.sql",
      "ai": {
        "description": "Retrieves the full detail of an appointment by its identifier."
      }
    },
    "appointments.appointments.history": {
      "permission": "appointments.view_appointment",
      "sql": "queries/appointment_history.sql",
      "ai": {
        "description": "Retrieves the status-change history of a specific appointment."
      }
    },
    "appointments.appointments.count_active_for_service": {
      "permission": "appointments.view_appointment",
      "sql": "queries/appointments_count_active_for_service.sql",
      "schema": "schemas/count_active_for_service.json",
      "ai": {
        "description": "Counts the upcoming live appointments (pending/confirmed, starting from now) of one service, with the earliest start. Public read used by `services` to warn before archiving a service."
      },
      "expose_api": true
    },
    "appointments.appointments.list_for_customer": {
      "permission": "appointments.view_appointment",
      "sql": "queries/appointments_list_for_customer.sql",
      "schema": "schemas/list_for_customer.json",
      "ai": {
        "description": "Lists the most recent appointments of one customer (newest first) with service, professional, status and the visit notes — the visit history the customer sheet shows. Public read used by the `customers.detail` slot."
      },
      "expose_api": true
    },
    "appointments.schedules.list": {
      "permission": "appointments.view_schedule",
      "sql": "queries/schedules_list.sql",
      "list": {
        "search": [
          "name",
          "description"
        ],
        "sort": [
          "id",
          "name",
          "description",
          "is_default",
          "is_active"
        ],
        "default_sort": "name",
        "default_dir": "asc",
        "filters": {
          "name": {
            "op": "like"
          },
          "description": {
            "op": "like"
          },
          "is_default": {
            "op": "eq"
          },
          "is_active": {
            "op": "eq"
          }
        },
        "page_size": 50
      },
      "ai": {
        "description": "Lists the availability schedules configured for staff members."
      }
    },
    "appointments.schedules.timeslots": {
      "permission": "appointments.view_schedule",
      "sql": "queries/schedule_timeslots.sql",
      "ai": {
        "description": "Retrieves the available time slots for a given staff schedule."
      }
    },
    "appointments.availability.slots": {
      "permission": "appointments.view_schedule",
      "sql": "queries/availability_slots.sql",
      "ai": {
        "description": "Returns the free booking slots for a given date (optionally for a specific staff member and duration), crossing schedules, blocked time, existing appointments and the slots currently set aside for pending booking requests with the booking-notice settings."
      }
    },
    "appointments.availability.check": {
      "permission": "appointments.view_schedule",
      "sql": "queries/availability_check.sql",
      "ai": {
        "description": "Checks whether a specific date/time slot is available for booking and returns the reason when it is not (too_soon, too_far, outside_schedule, blocked, overlap or held — `held` means another pending booking request has that slot set aside for a few minutes)."
      }
    },
    "appointments.blocked_times.list": {
      "permission": "appointments.view_schedule",
      "sql": "queries/blocked_times_list.sql",
      "list": {
        "search": [
          "title"
        ],
        "sort": [
          "id",
          "title",
          "block_type",
          "start_datetime",
          "end_datetime",
          "all_day",
          "staff_id",
          "reason"
        ],
        "default_sort": "id",
        "default_dir": "asc",
        "filters": {
          "title": {
            "op": "like"
          },
          "block_type": {
            "op": "eq"
          },
          "start_datetime": {
            "op": "eq"
          },
          "end_datetime": {
            "op": "eq"
          },
          "all_day": {
            "op": "eq"
          },
          "staff_id": {
            "op": "eq"
          },
          "reason": {
            "op": "like"
          }
        },
        "page_size": 50
      },
      "ai": {
        "description": "Lists blocked time periods (holidays, vacations) for staff members."
      }
    },
    "appointments.recurring.get": {
      "permission": "appointments.view_appointment",
      "sql": "queries/recurring_get.sql",
      "ai": {
        "description": "Retrieves one recurring appointment template by its identifier, with its three links and its full repetition rule, used by the materialize handler as its authoritative source (runtime reads)."
      }
    },
    "appointments.recurring.occurrences": {
      "permission": "appointments.view_appointment",
      "sql": "queries/recurring_occurrences.sql",
      "ai": {
        "description": "Lists the occurrences of one recurring appointment that are already on the books (cancelled ones included, since a cancelled occurrence is an exception of the series), used by the materialize handler to never book the same occurrence twice (runtime reads)."
      }
    },
    "appointments.recurring.list": {
      "permission": "appointments.view_appointment",
      "sql": "queries/recurring_list.sql",
      "list": {
        "search": [
          "customer_name",
          "service_name",
          "staff_name"
        ],
        "sort": [
          "id",
          "customer_name",
          "service_name",
          "staff_name",
          "frequency",
          "day_of_week",
          "time",
          "duration_minutes",
          "start_date",
          "end_date",
          "max_occurrences",
          "is_active"
        ],
        "default_sort": "id",
        "default_dir": "asc",
        "filters": {
          "customer_name": {
            "op": "like"
          },
          "service_name": {
            "op": "like"
          },
          "staff_name": {
            "op": "like"
          },
          "frequency": {
            "op": "eq"
          },
          "day_of_week": {
            "op": "eq"
          },
          "time": {
            "op": "eq"
          },
          "duration_minutes": {
            "op": "eq"
          },
          "start_date": {
            "op": "range"
          },
          "end_date": {
            "op": "range"
          },
          "max_occurrences": {
            "op": "range"
          },
          "is_active": {
            "op": "eq"
          }
        },
        "page_size": 50
      },
      "ai": {
        "description": "Lists configured recurring appointment templates."
      }
    },
    "appointments.agenda.status": {
      "permission": "appointments.view_schedule",
      "sql": "queries/agenda_status.sql",
      "ai": {
        "description": "Reports whether the agenda is set up: how many active schedules and bookable weekly time slots the business has declared."
      }
    },
    "appointments.settings.get": {
      "permission": "appointments.view_appointment",
      "sql": "queries/settings_get.sql",
      "ai": {
        "description": "Retrieves the general settings of the appointments module."
      }
    },
    "appointments.appointments.conflicting": {
      "permission": "appointments.view_appointment",
      "sql": "queries/appointments_conflicting.sql",
      "ai": {
        "description": "Loads live appointments for the same day as the requested start, used by the create handler to detect overlapping bookings authoritatively (runtime reads)."
      }
    },
    "appointments.blocked_times.overlapping": {
      "permission": "appointments.view_schedule",
      "sql": "queries/blocked_times_overlapping.sql",
      "ai": {
        "description": "Loads the agenda's blocked periods (holidays, closures, a professional's block) that may cover the requested day, used by the create and reschedule handlers to refuse a booking on blocked time authoritatively (runtime reads)."
      }
    },
    "appointments.blocked_times.upcoming": {
      "permission": "appointments.view_schedule",
      "sql": "queries/blocked_times_upcoming.sql",
      "ai": {
        "description": "Loads every blocked period of the agenda that has not ended yet, used by the batch and recurring handlers, which book across several days and cannot ask for the blocks of one day (runtime reads)."
      }
    },
    "appointments.appointments.upcoming_for_staff": {
      "permission": "appointments.view_appointment",
      "sql": "queries/appointments_upcoming_for_staff.sql",
      "ai": {
        "description": "Loads a professional's live appointments that have not ended yet, used by the batch and recurring handlers to detect overlapping bookings across several days authoritatively (runtime reads)."
      }
    },
    "appointments.slot_holds.live": {
      "permission": "appointments.view_schedule",
      "sql": "queries/slot_holds_live.sql",
      "ai": {
        "description": "Loads the LIVE slot holds of the requested day — slots set aside while somebody decides on a pending booking request — used by the create, reschedule and booking-request handlers to refuse selling a slot that is already spoken for (runtime reads)."
      }
    },
    "appointments.slot_holds.upcoming": {
      "permission": "appointments.view_schedule",
      "sql": "queries/slot_holds_upcoming.sql",
      "ai": {
        "description": "Loads every live slot hold still ahead, used by the batch and recurring handlers, which span several days and cannot express one day per read (runtime reads)."
      }
    }
  },
  "commands": {
    "appointments.appointments.create": {
      "permission": "appointments.add_appointment",
      "schema": "schemas/appointment_create.json",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "create_appointment"
      },
      "emit": [
        "appointments.appointment.created"
      ],
      "ai": {
        "description": "Creates a new appointment for a customer with a specified service, professional and date/time. The customer, service and professional are resolved against the hub's records (name, price and duration are frozen from the catalogue, never from the caller)."
      },
      "reads": [
        {
          "query": "appointments.appointments.conflicting",
          "params": {
            "staff_id": "payload.staff_id",
            "start_datetime": "payload.start_datetime"
          },
          "required": true
        },
        {
          "query": "appointments.settings.get",
          "required": true
        },
        {
          "query": "customers.get",
          "params": {
            "customer_id": "payload.customer_id"
          },
          "required": true
        },
        {
          "query": "services.services.get",
          "params": {
            "service_id": "payload.service_id"
          },
          "required": true
        },
        {
          "query": "staff.members.get",
          "params": {
            "staff_id": "payload.staff_id"
          },
          "required": true
        },
        {
          "query": "staff.services.eligible_for_service",
          "params": {
            "service_id": "payload.service_id"
          },
          "required": true
        },
        {
          "query": "appointments.blocked_times.overlapping",
          "params": {
            "staff_id": "payload.staff_id",
            "start_datetime": "payload.start_datetime"
          },
          "required": true
        },
        {
          "query": "appointments.slot_holds.live",
          "params": {
            "staff_id": "payload.staff_id",
            "start_datetime": "payload.start_datetime"
          },
          "required": true
        }
      ]
    },
    "appointments.appointments.update": {
      "permission": "appointments.change_appointment",
      "transaction": true,
      "sql": [
        "commands/appointment_update.sql",
        "commands/_appointment_overlap_assert.sql"
      ],
      "schema": "schemas/appointment_update.json",
      "emit": [
        "appointments.appointment.updated"
      ],
      "ai": {
        "description": "Updates an existing appointment's details such as notes, duration, or assigned employee."
      }
    },
    "appointments.appointments.confirm": {
      "permission": "appointments.change_appointment",
      "transaction": true,
      "sql": [
        "commands/appointment_confirm.sql",
        "commands/_history_confirm.sql"
      ],
      "expect_rows": {
        "op": "min",
        "n": 1,
        "error": "appointments.cannot_confirm",
        "message": "This appointment can no longer be confirmed: it is not pending any more."
      },
      "schema": "schemas/appointment_id.json",
      "emit": [
        "appointments.appointment.confirmed"
      ],
      "ai": {
        "description": "Confirms a pending appointment, changing its status to confirmed."
      }
    },
    "appointments.appointments.start": {
      "permission": "appointments.change_appointment",
      "transaction": true,
      "sql": [
        "commands/appointment_start.sql",
        "commands/_history_start.sql"
      ],
      "expect_rows": {
        "op": "min",
        "n": 1,
        "error": "appointments.cannot_start",
        "message": "This appointment cannot be started: it is not confirmed."
      },
      "schema": "schemas/appointment_id.json",
      "emit": [
        "appointments.appointment.started"
      ],
      "ai": {
        "description": "Marks a confirmed appointment as in progress (service started)."
      }
    },
    "appointments.appointments.complete": {
      "permission": "appointments.change_appointment",
      "transaction": true,
      "sql": [
        "commands/appointment_complete.sql",
        "commands/_history_complete.sql"
      ],
      "expect_rows": {
        "op": "min",
        "n": 1,
        "error": "appointments.cannot_complete",
        "message": "This appointment cannot be completed: it has not been started."
      },
      "schema": "schemas/appointment_id.json",
      "emit": [
        "appointments.appointment.completed"
      ],
      "ai": {
        "description": "Marks an in-progress appointment as completed."
      }
    },
    "appointments.appointments.cancel": {
      "permission": "appointments.change_appointment",
      "schema": "schemas/appointment_cancel.json",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "cancel_appointment"
      },
      "reads": [
        {
          "query": "appointments.appointments.get",
          "params": {
            "appointment_id": "payload.appointment_id"
          },
          "required": true
        },
        {
          "query": "appointments.settings.get",
          "required": true
        }
      ],
      "emit": [
        "appointments.appointment.cancelled"
      ],
      "ai": {
        "description": "Cancels an appointment with a specified cancellation reason. Staff can always cancel; a cancellation on behalf of the customer (channel=customer) is subject to the cancellation policy (allow_customer_cancellation, cancellation_notice_hours)."
      }
    },
    "appointments._cancel_row": {
      "permission": "appointments.change_appointment",
      "sql": [
        "commands/appointment_cancel.sql"
      ]
    },
    "appointments._history_cancel": {
      "permission": "appointments.change_appointment",
      "sql": [
        "commands/_history_cancel.sql"
      ]
    },
    "appointments.appointments.no_show": {
      "permission": "appointments.change_appointment",
      "transaction": true,
      "sql": [
        "commands/appointment_no_show.sql",
        "commands/_history_no_show.sql"
      ],
      "expect_rows": {
        "op": "min",
        "n": 1,
        "error": "appointments.cannot_mark_no_show",
        "message": "This appointment cannot be marked as a no-show in its current state."
      },
      "schema": "schemas/appointment_id.json",
      "emit": [
        "appointments.appointment.no_show"
      ],
      "ai": {
        "description": "Records that the customer did not show up for their scheduled appointment."
      }
    },
    "appointments.appointments.reschedule": {
      "permission": "appointments.change_appointment",
      "schema": "schemas/appointment_reschedule.json",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "reschedule_appointment"
      },
      "emit": [
        "appointments.appointment.rescheduled"
      ],
      "ai": {
        "description": "Moves an appointment to another date and time. The end of the slot is computed from the start and the duration, and the move is refused when it lands on a blocked period or breaks the hub's minimum notice or maximum advance. The professional is the appointment's own; this command does not change it."
      },
      "reads": [
        {
          "query": "appointments.appointments.get",
          "params": {
            "appointment_id": "payload.appointment_id"
          },
          "required": true
        },
        {
          "query": "appointments.settings.get",
          "required": true
        },
        {
          "query": "appointments.appointments.conflicting",
          "params": {
            "start_datetime": "payload.start_datetime"
          },
          "required": true
        },
        {
          "query": "appointments.blocked_times.upcoming",
          "required": true
        },
        {
          "query": "appointments.slot_holds.live",
          "params": {
            "start_datetime": "payload.start_datetime"
          },
          "required": true
        }
      ]
    },
    "appointments._reschedule_state_assert": {
      "permission": "appointments.change_appointment",
      "sql": [
        "commands/_reschedule_state_assert.sql"
      ]
    },
    "appointments._reschedule_row": {
      "permission": "appointments.change_appointment",
      "sql": [
        "commands/appointment_reschedule.sql"
      ]
    },
    "appointments._appointment_overlap_assert": {
      "permission": "appointments.change_appointment",
      "sql": [
        "commands/_appointment_overlap_assert.sql"
      ]
    },
    "appointments._history_reschedule": {
      "permission": "appointments.change_appointment",
      "sql": [
        "commands/_history_reschedule.sql"
      ]
    },
    "appointments.appointments.delete": {
      "permission": "appointments.delete_appointment",
      "transaction": true,
      "sql": [
        "commands/appointment_delete.sql"
      ],
      "schema": "schemas/appointment_id.json",
      "emit": [
        "appointments.appointment.deleted"
      ],
      "ai": {
        "description": "Permanently deletes an appointment from the system (destructive).",
        "risk": "destructive"
      }
    },
    "appointments.appointments.bulk_create": {
      "permission": "appointments.add_appointment",
      "schema": "schemas/appointment_bulk_create.json",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "bulk_create"
      },
      "ai": {
        "description": "Books several slots at once for the SAME customer, service and professional (a session pass, a course). The customer, service and professional are resolved against the hub's records: name, price and duration are frozen from the catalogue, never from the caller, and an id that does not resolve refuses the whole batch."
      },
      "reads": [
        {
          "query": "appointments.settings.get",
          "required": true
        },
        {
          "query": "customers.get",
          "params": {
            "customer_id": "payload.customer_id"
          },
          "required": true
        },
        {
          "query": "services.services.get",
          "params": {
            "service_id": "payload.service_id"
          },
          "required": true
        },
        {
          "query": "staff.members.get",
          "params": {
            "staff_id": "payload.staff_id"
          },
          "required": true
        },
        {
          "query": "staff.services.eligible_for_service",
          "params": {
            "service_id": "payload.service_id"
          },
          "required": true
        },
        {
          "query": "appointments.blocked_times.upcoming",
          "required": true
        },
        {
          "query": "appointments.appointments.upcoming_for_staff",
          "params": {
            "staff_id": "payload.staff_id"
          },
          "required": true
        },
        {
          "query": "appointments.slot_holds.upcoming",
          "params": {
            "staff_id": "payload.staff_id"
          },
          "required": true
        }
      ]
    },
    "appointments.appointments.bulk_delete": {
      "permission": "appointments.delete_appointment",
      "schema": "schemas/appointment_bulk_delete.json",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "bulk_delete"
      },
      "ai": {
        "description": "Permanently deletes multiple appointments in bulk (destructive).",
        "risk": "bulk_destructive"
      }
    },
    "appointments.recurring.materialize": {
      "permission": "appointments.add_appointment",
      "schema": "schemas/recurring_materialize.json",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "materialize_recurring"
      },
      "ai": {
        "description": "Books the concrete appointments of a recurring template, named by its identifier. The repetition rule comes from the template row and the customer, service and professional are resolved against the hub's records; ids that do not match the template are refused."
      },
      "reads": [
        {
          "query": "appointments.recurring.get",
          "params": {
            "recurring_id": "payload.recurring_id"
          },
          "required": true
        },
        {
          "query": "appointments.recurring.occurrences",
          "params": {
            "recurring_id": "payload.recurring_id"
          },
          "required": true
        },
        {
          "query": "appointments.settings.get",
          "required": true
        },
        {
          "query": "customers.get",
          "params": {
            "customer_id": "payload.customer_id"
          },
          "required": true
        },
        {
          "query": "services.services.get",
          "params": {
            "service_id": "payload.service_id"
          },
          "required": true
        },
        {
          "query": "staff.members.get",
          "params": {
            "staff_id": "payload.staff_id"
          },
          "required": true
