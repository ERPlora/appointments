    "appointments.availability.check": {
      "permission": "appointments.view_schedule",
      "schema": "schemas/availability_check.json",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "check_availability"
      },
      "ai": {
        "description": "Checks whether a specific date/time slot is available for booking and returns the reason when it is not (outside_schedule, outside_staff_hours, invalid_start, too_soon, too_far, blocked or overlap — `outside_schedule` means the business is shut at that hour, `outside_staff_hours` that the asked professional does not work then: off-shift, on their break or on approved leave). It answers the SAME opening hours the booking door enforces, read from the `schedules` module, so an hour this says is free is an hour a booking will be accepted at. With `staff_id` it also answers that professional's working hours, read from the `staff` module."
      },
      "reads": [
        {
          "query": "appointments.availability.own_rules",
          "params": {
            "start_datetime": "payload.start_datetime",
            "duration_minutes": "payload.duration_minutes",
            "staff_id": "payload.staff_id"
          },
          "required": true
        },
        {
          "query": "appointments.settings.get",
          "required": true
        },
        {
          "query": "staff.availability.day_at",
          "params": {
            "staff_id": "payload.staff_id",
            "at": "payload.start_datetime"
          },
          "required": true
        },
        {
          "query": "schedules.business_hours.list",
          "required": true
        },
        {
          "query": "schedules.special_days.list",
          "required": true
        },
        {
          "query": "schedules.overrides.list",
          "required": true
        },
        {
          "query": "schedules.exception_intervals.list",
          "required": true
        }
      ]
    },
    "appointments.availability.slots": {
      "permission": "appointments.view_schedule",
      "schema": "schemas/availability_slots.json",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "available_slots"
      },
      "ai": {
        "description": "Lists the free booking slots of a given date (optionally for one staff member and a duration), crossing the calendar window and booking-notice settings, blocked time and existing appointments. It answers the SAME opening hours the booking door enforces, read from the `schedules` module, so an hour this offers is an hour a booking will be accepted at — the business being shut that date comes back as an empty list. With `staff_id` it also keeps only the hours that professional works (their shift, outside their break and any approved leave), read from the `staff` module."
      },
      "reads": [
        {
          "query": "appointments.availability.own_slots",
          "params": {
            "date": "payload.date",
            "duration_minutes": "payload.duration_minutes",
            "staff_id": "payload.staff_id"
          },
          "required": true
        },
        {
          "query": "staff.availability.day_at",
          "params": {
            "staff_id": "payload.staff_id",
            "at": "payload.date"
          },
          "required": true
        },
        {
          "query": "schedules.business_hours.list",
          "required": true
        },
        {
          "query": "schedules.special_days.list",
          "required": true
        },
        {
          "query": "schedules.overrides.list",
          "required": true
        },
        {
          "query": "schedules.exception_intervals.list",
          "required": true
        }
      ]
    },
    "appointments.availability.day_opening": {
      "permission": "appointments.view_schedule",
      "schema": "schemas/day_opening.json",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "day_opening"
      },
      "reads": [
        {
          "query": "schedules.business_hours.list",
          "required": true
        },
        {
          "query": "schedules.special_days.list",
          "required": true
        },
        {
          "query": "schedules.overrides.list",
          "required": true
        },
        {
          "query": "schedules.exception_intervals.list",
          "required": true
        }
      ],
      "ai": {
        "description": "Returns the stretches the business is open on a given date, exactly as the booking gate resolves them: the rules of the Schedules module with their precedence applied (exact special day, yearly special day, override range, weekly hours) and breaks carved out. `spans` are minutes from that date's own midnight and `source` says who answered — `schedules` when the authority resolved the date (an empty `spans` then means the business is shut that day), `unset` when it carries no rule reaching the date, and then nothing is refused and the caller must not filter at all. Read-only: it writes nothing."
      }
    },
    "appointments.blocked_times.create": {
