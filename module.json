        "risk": "destructive"
      }
    },
    "appointments.recurring.deactivate": {
      "permission": "appointments.change_appointment",
      "transaction": true,
      "sql": [
        "commands/recurring_deactivate.sql"
      ],
      "expect_rows": {
        "op": "min",
        "n": 1,
        "error": "appointments.recurring_not_found",
        "message": "That recurring series does not exist in this business or it has already been deleted."
      },
      "schema": "schemas/recurring_id.json",
      "emit": [
        "appointments.recurring.updated"
      ],
      "ai": {
        "description": "Deactivates a recurring appointment template without deleting it. Its already booked occurrences are kept; it just stops being offered for new bookings — `materialize` refuses an inactive template — until it is reactivated."
      }
    },
    "appointments.recurring.activate": {
      "permission": "appointments.change_appointment",
      "transaction": true,
      "sql": [
        "commands/recurring_activate.sql"
      ],
      "expect_rows": {
        "op": "min",
        "n": 1,
        "error": "appointments.recurring_not_found",
        "message": "That recurring series does not exist in this business or it has already been deleted."
      },
      "schema": "schemas/recurring_id.json",
      "emit": [
        "appointments.recurring.updated"
      ],
      "ai": {
        "description": "Reactivates a previously deactivated recurring appointment template. It does not book any occurrence by itself — that is `materialize`."
      }
    },
    "appointments.recurring.materialize": {
      "permission": "appointments.add_appointment",
      "schema": "schemas/recurring_materialize.json",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "materialize_recurring"
      },
      "ai": {
        "description": "Books the concrete appointments of a recurring template, named by its identifier. The repetition rule comes from the template row and the customer, service and professional are resolved against the hub's records; ids that do not match the template are refused. An occurrence that cannot be booked (outside the professional's hours or the opening hours, a blocked time, a time already taken, the past) is skipped and the rest still book; the answer says how many were booked (`booked`), how many were already on the agenda (`already_booked`) and lists every skipped date with its refusal code (`skipped`: `occurrence_date`, `code`), so they can be told to the person."
      },
      "reads": [
        {
          "query": "appointments.recurring.get",
          "params": {
            "recurring_id": "payload.recurring_id"
          },
          "required": true
        },
        {
          "query": "appointments.recurring.occurrences",
          "params": {
            "recurring_id": "payload.recurring_id"
          },
          "required": true
        },
        {
          "query": "appointments.settings.get",
          "required": true
        },
        {
          "query": "customers.get",
          "params": {
            "customer_id": "payload.customer_id"
          },
          "required": true
        },
        {
          "query": "services.services.get",
          "params": {
            "service_id": "payload.service_id"
          },
          "required": true
        },
        {
          "query": "staff.members.get",
          "params": {
            "staff_id": "payload.staff_id"
          },
          "required": true
        },
        {
          "query": "staff.services.eligible_for_service",
          "params": {
            "service_id": "payload.service_id"
          },
          "required": true
        },
        {
          "query": "appointments.blocked_times.upcoming",
          "required": true
        },
        {
          "query": "appointments.appointments.upcoming_for_staff",
          "params": {
            "staff_id": "payload.staff_id"
          },
          "required": true
        },
        {
          "query": "staff.availability.days_ahead",
          "params": {
            "staff_id": "payload.staff_id",
            "days": "400"
          },
          "required": true
        },
        {
          "query": "schedules.business_hours.list",
          "required": true
        },
        {
          "query": "schedules.special_days.list",
          "required": true
        },
        {
          "query": "schedules.overrides.list",
          "required": true
        },
        {
          "query": "schedules.exception_intervals.list",
          "required": true
        }
      ]
    },
    "appointments.recurring.update": {
      "permission": "appointments.change_appointment",
      "transaction": true,
      "schema": "schemas/recurring_update.json",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "update_recurring_series"
      },
      "emit": [
        "appointments.recurring.updated"
      ],
      "ai": {
        "description": "Edits a recurring appointment from one of its occurrences onwards ('this and all following'), changing the time, the duration and/or the repetition pattern (how often it repeats and which weekday). The series is split in two: the original template stops the day before, a new one starts at that occurrence, and the appointments already booked from there on are moved to the new time. When the pattern changes, the bookings that no longer fall on a day of the new pattern are cancelled instead of moved, and the answer says how many. Appointments before today, cancelled ones, ones in progress and ones already turned into a sale are never touched. It does not book the appointments of the new pattern: that is 'materialize'."
      },
      "reads": [
        {
          "query": "appointments.recurring.get",
          "params": {
            "recurring_id": "payload.recurring_id"
          },
          "required": true
        },
        {
          "query": "appointments.recurring.occurrences",
          "params": {
            "recurring_id": "payload.recurring_id"
          },
          "required": true
        }
      ]
    },
